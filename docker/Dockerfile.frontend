# MedTwin web app — Vite build served by nginx (also proxies API + WebSocket)
# The Vite entry (index.html) lives at the repo root; sources in frontend/.
FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package.json /app/frontend/
RUN cd frontend && npm install && ln -s frontend/node_modules /app/node_modules
COPY index.html /app/
COPY frontend/ /app/frontend/
RUN cd frontend && npm run build

FROM nginx:1.27-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/frontend/dist /usr/share/nginx/html
EXPOSE 80
