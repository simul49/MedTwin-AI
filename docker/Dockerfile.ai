# MedTwin AI service (RAG, safety, extraction) — reuses Django models as ORM
FROM python:3.12-slim
WORKDIR /srv
COPY backend/requirements.txt /srv/backend/requirements.txt
COPY backend-ai/requirements.txt /srv/backend-ai/requirements.txt
RUN pip install --no-cache-dir -r /srv/backend/requirements.txt -r /srv/backend-ai/requirements.txt
COPY backend/ /srv/backend/
COPY backend-ai/ /srv/backend-ai/
RUN mkdir -p /var/medtwin/documents
EXPOSE 8002
WORKDIR /srv/backend-ai
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8002"]
